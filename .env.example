APP_NAME="Precious Pakistan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Primary database (MySQL 8.4 in production / MariaDB 10.4+ in XAMPP local dev)
# Automated tests use isolated SQLite :memory: via phpunit.xml
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=preciouspakistan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
UPLOADS_DISK=uploads
PRIVATE_UPLOADS_DISK=private_uploads

# Local dev uses database queues/cache; Hostinger VPS production can switch to redis
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=precious_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bookings@preciouspakistan.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional MFA Hook (disabled by default until explicitly enabled)
PRECIOUS_MFA_ENABLED=false
PRECIOUS_MFA_DRIVER=null

# Optional non-interactive Super Admin bootstrap secrets (only used by `php artisan precious:install-super-admin --from-env`)
# Never commit real production credentials to version control.
# PRECIOUS_SUPER_ADMIN_NAME="Precious Pakistan Super Admin"
# PRECIOUS_SUPER_ADMIN_EMAIL=
# PRECIOUS_SUPER_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
